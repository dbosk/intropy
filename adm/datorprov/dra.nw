Misslyckas något efter protokollet ska protokollet ligga kvar och
meddelandet säga vad som är på plats.
Här skriver vi över en befintlig provfil med [[--skriv-over]], medan
frågefilen pekar på en katalog, så att den sista flytten misslyckas.
Då ligger både protokollet och den nya provfilen på plats, och de ska höra
ihop.
<<test functions>>=
def test_failure_after_the_record_keeps_it_and_says_so(tmp_path, capsys):
    template, banker = make_exam(tmp_path)
    prov = tmp_path / "a-prov.json"
    prov.write_text("gammal\n", encoding="utf-8")
    fragor = tmp_path / "fragor"
    fragor.mkdir()
    status, prov, protokoll = run_dra(
        tmp_path, template, banker, "a", "--skriv-over", "--fragor", str(fragor)
    )
    assert status == 1
    err = capsys.readouterr().err
    assert f"På plats: {protokoll}, {prov}." in err
    assert f"--seed {read(protokoll)['seed']}" in err
    assert [p["title"] for p in read(protokoll)["positions"]] == [
        i["entry"]["title"] for i in read(prov)["items"]
    ]
    assert fragor.is_dir()
    assert not [p for p in tmp_path.iterdir() if p.name.endswith(".tmp")]
