    assert status == 1
    assert "checkas in" in capsys.readouterr().err
    assert not prov.exists() and not protokoll.exists()


@pytest.mark.skipif(shutil.which("git") is None, reason="needs git")
def test_dubious_ownership_is_refused(tmp_path, capsys, monkeypatch):
    template, banker = make_exam(tmp_path)
    repo = ignoring_repo(tmp_path)
    monkeypatch.setenv("GIT_TEST_ASSUME_DIFFERENT_OWNER", "1")
    status, prov, protokoll = run_dra(repo, template, banker, "a")
    assert status == 1
    assert "checkas in" in capsys.readouterr().err
    assert not prov.exists()
