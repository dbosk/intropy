Varje position måste ange en bank och en poäng.
Vi anger positionens nummer i felmeddelandet, eftersom det är så författaren
tänker på provet (\enquote{position 7 saknar bank}).
<<kontrollera mallens positioner>>=
positions = template.get("positions")
if not isinstance(positions, list) or not positions:
    raise DrawError(f"Provmallen {path} saknar en lista med positioner")
for number, slot in enumerate(positions, start=1):
    if not isinstance(slot, dict) or not isinstance(slot.get("bank"), str):
        raise DrawError(f"Position {number} i provmallen anger ingen bank")
    points = slot.get("points")
