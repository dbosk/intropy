    item
    for item in items
    if item_title(item) not in avoided and item_title(item) not in taken
]
repeated = False
if not candidates:
    if not allow_repeats:
        raise DrawError(
            f"Banken {name} (position {position}) har inga frågor kvar: "
            f"alla {len(items)} har dragits vid tidigare tillfällen "
            "(--undvik) eller redan i detta prov. Skriv fler frågor till "
            "banken, eller tillåt upprepning med --tillat-upprepning."
        )
    candidates = [item for item in items if item_title(item) not in taken]
    repeated = True
    if not candidates:
        raise DrawError(
            f"Banken {name} har för få frågor för alla positioner som "
            "drar ur den"
        )
