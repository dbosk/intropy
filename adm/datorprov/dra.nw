def write_json_file(path, data):
    path.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")


def made_up_item(bank, number):
    return {
        "position": number,
        "points_possible": 1,
        "entry": {
            "title": f"{bank} #{number}",
            "item_body": f"<p>Påhittad fråga {number} i bank {bank}.</p>",
            "interaction_type_slug": "true-false",
            "interaction_data": {
                "true_choice": "Sant",
                "false_choice": "Falskt",
            },
            "scoring_data": {"value": True},
            "scoring_algorithm": "Equivalence",
        },
    }


def make_bank(directory, name, size):
    items = [made_up_item(name, number) for number in range(1, size + 1)]
    write_json_file(
        directory / f"{name}.json",
        {
            "bank": name,
            "title": f"Påhittad bank {name}",
            "learning_objective": int(name.split(".")[0]),
            "items": items,
        },
    )
@

Mallen följer samma regel som det riktiga provet: tre positioner per
lärandemål, med poängen \(10^{L-1}\), men med färre lärandemål så att
testerna är lätta att överblicka.
Med [[sizes]] kan ett test ge en enskild bank ett annat antal frågor.
<<test helpers>>=
def make_exam(tmp_path, los=2, size=10, sizes={}):
    banker = tmp_path / "banker"
    banker.mkdir()
    positions = []
    for lo in range(1, los + 1):
        for k in range(1, 4):
            name = f"{lo}.{k}"
            make_bank(banker, name, sizes.get(name, size))
            positions.append({"bank": name, "points": 10 ** (lo - 1)})
    template = tmp_path / "mall.json"
    write_json_file(
        template,
        {
            "quiz_type": "new",
            "settings": {
                "title": "Påhittat prov",
                "points_possible": sum(slot["points"] for slot in positions),
                "quiz_settings": {"shuffle_answers": True},
            },
            "positions": positions,
        },
    )
    return template, banker
@

