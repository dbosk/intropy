Efter protokollet håller vi reda på vilka filer som kommit på plats, så att
meddelandet kan räkna upp dem.
<<lägg provfilen och frågefilen på plats>>=
placed = [record_path]
try:
    for path, _ in files:
        if overwrite:
            os.replace(temporary[path], path)
        else:
            os.link(temporary[path], path)
        placed.append(path)
except OSError as err:
    raise DrawError(
        f"{failed_write(err)}. På plats: {', '.join(map(str, placed))}. "
        f"Protokollet dokumenterar dragningen; provfilen kan skapas igen "
        f"med --seed {record['seed']}, samma filer och ett nytt --protokoll."
