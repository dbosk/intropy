    It reads each file named on the command line and prints what kind of
    file it is:
<<[[show_draw.py]]>>=
"""Print an excerpt of dra.py's draw records and quiz files"""

import json
import sys


def show_record(path, record):
    """Print the seed, the checksums and the drawn titles of a record"""
    avoided = [entry["path"] for entry in record["avoided"]]
    print(f"{path}: seed {record['seed']}, avoided {avoided}")
    checksums = [record["template"]["sha256"][:8]]
    for bank in record["banks"].values():
        checksums.append(bank["sha256"][:8])
    print(f"  checksums: {' '.join(checksums)}")
    titles = [slot["title"] for slot in record["positions"]]
    print(f"  drawn: {', '.join(titles)}")


def show_quiz(path, quiz):
    """Print the title, the total and the items of a quiz file"""
    settings = quiz["settings"]
    print(f"{path}: {settings['title']}, {settings['points_possible']} p")
    for item in quiz["items"]:
        title = item["entry"]["title"]
        print(f"  {item['position']}: {title}, {item['points_possible']} p")


def main():
    """Print an excerpt of every file named on the command line"""
    for path in sys.argv[1:]:
        with open(path, encoding="utf-8") as file:
            data = json.load(file)
        if "positions" in data:
            show_record(path, data)
        else:
            show_quiz(path, data)


main()
@
  \end{example}
\end{frame}

