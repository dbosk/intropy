def main():
    """Provar jämförelserna och divisionen"""
    third = Fraction(1, 3)
    two_sixths = Fraction(2, 6)
    print(f"1/3 == 2/6: {third == two_sixths}")
    print(f"1/3 < 1/2: {third < Fraction(1, 2)}")
    print(f"1/3 > 2/6: {third > two_sixths}")

    negative_denominator = Fraction(1, -2)
    negative_numerator = Fraction(-1, 2)
    print(f"1/-2 == -1/2: {negative_denominator == negative_numerator}")
    print(f"1/3 == '1/3': {third == '1/3'}")

    parts = {Fraction(1, 2): "en halv", Fraction(1, 3): "en tredjedel"}
    print(f"parts[Fraction(2, 6)]: {parts[Fraction(2, 6)]}")

    half = Fraction(1, 2)
    print(f"1/2 / 2/3 = {half / Fraction(2, 3)}")
    print(f"1/2 / 2 = {half / 2}")
    print(f"1 / (1/2) = {1 / half}")

    try:
        print(1 < half)
    except TypeError as error:
