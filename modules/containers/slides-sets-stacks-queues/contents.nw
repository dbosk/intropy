def main():
    """Huvudprogrammet"""
    saker = []
    saker.append(1)
    saker.append(2)
    saker.append(3)
    print(f"saker = {saker}")

    while saker:
        print(f"saker.pop() = {saker.pop()}")
        print(f"saker = {saker}")


