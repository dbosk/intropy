import collections


def main():
    """Huvudprogrammet"""
    saker = collections.deque()
    saker.append(1)
    saker.append(2)
    saker.append(3)
    print(f"saker = {saker}")

    while saker:
        print(f"saker.popleft() = {saker.popleft()}")
        print(f"saker = {saker}")


if __name__ == "__main__":
    main()
