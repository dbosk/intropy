\label{sec:diska}

\mode<article>{%
  \OvningVariablesLODefine*
}

\leavevmode\ltnote{%
  Relevanta lärandemål: \cref{OvningVariablesLODefine}.

  \textbf{Förbättrad uppgift} (gamla \enquote{Att göra saker}, andra
