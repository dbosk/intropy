def bmi(weight_kg, height_cm):
    """Returnerar BMI för en vikt i kilogram och en längd i cm."""
    height_m = height_cm / 100
    return weight_kg / (height_m * height_m)


def main():
    """Skriver ut BMI för samma vikt med två olika längdvärden."""
    print(bmi(65, 170))
    print(bmi(65, 1.70))


