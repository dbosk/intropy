    Spara punkten om den är den första, annars rita:
<<metoden [[paint]]>>=
def paint(self, event):
    """Draw a line from the previous point to this one"""
    <<rita en linje från den förra punkten>>
@
<<rita en linje från den förra punkten>>=
if self.x_old is None:
    self.x_old = event.x
    self.y_old = event.y
