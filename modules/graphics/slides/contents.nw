\begin{frame}[fragile]
  \begin{solution}[Klassen]
    En bindning och en metod till:
<<fönstret som också hälsar vid Enter>>=
class EnterGUI(InputGUI):
    """The greeting window, which also greets when Enter is pressed"""

    def __init__(self):
        """Create the greeting window, and bind Enter in the entry"""
        super().__init__()
        self.name_entry.bind("<Return>", self.greet_on_enter)

    def greet_on_enter(self, _):
        """Greet as if OK had been pressed"""
        self.update_output()
@
  \end{solution}
\end{frame}

