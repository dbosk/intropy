% One line of this part is wider than the frame at the decks' minted
% size; the frame shrinks on the slides only (the notes ignore shrink).
\begin{frame}[fragile,shrink=15]
  \begin{example}[Dokumentationen för \texttt{bind}, slutet]
    \label{ex:pydoc-bind-3}
    Vad funktionen får, och resten av texten:
    \runshell[breaklines]{pydoc3 tkinter.Entry.bind | tail -n +28}
