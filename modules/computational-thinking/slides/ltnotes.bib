% === provenance: bohm1966 ===
% CLAIM: An algorithm's control flow decomposes into a small fixed set of
%   structures --- sequence (composition), selection and iteration --- the
%   structured-program theorem.
% FOUND-VIA: scholar search "Flow diagrams Turing machines languages two
%   formation rules" -p openalex -p s2 -p dblp -f bibtex (DOI resolved).
% PICKED: the primary source of the structured-program theorem, over later
%   textbook restatements.
% QUOTE (p. 366): "every Turing machine is reducible into, or in a
%   de[ter]mined sense is equivalent to, a program written in a language
%   which admits as formation rules only composition and iteration"; and
%   "methods of normalization of diagrams are studied, which allow them to
%   be decomposed into base diagrams of three types (first result) or of
%   two types (second result)."
% VERIFIED: full text read via scholar pdf quote over
%   https://www.cs.unibo.it/~martini/PP/bohm-jac.pdf (open scan; OCR noise
%   in brackets is the scan's).  The canonical "sequence, selection,
%   iteration" reading is the three-base-diagram form; Böhm--Jacopini prove
%   composition+iteration suffice (selection being expressible), so the
%   theorem grounds branching and repetition as the control structures over
%   the sequential base.
% DATE: 2026-07-20
@article{bohm1966,
  author  = {Böhm, Corrado and Jacopini, Giuseppe},
  title   = {Flow Diagrams, {Turing} Machines and Languages With Only Two
             Formation Rules},
  journal = {Communications of the ACM},
  volume  = {9},
  number  = {5},
  pages   = {366--371},
  year    = {1966},
  doi     = {10.1145/355592.365646}
}

% === provenance: pea1986 ===
% CLAIM: Novices routinely fail to discern that execution is sequential ---
%   one line active at a time --- reading a program instead as static text
%   whose lines are all simultaneously active (the parallelism bug), so
%   sequence/execution-order is a critical aspect that must be taught, not
%   assumed.
% FOUND-VIA: scholar search "Pea language-independent conceptual bugs novice
%   programming" -p openalex -f bibtex.
% PICKED: the classic primary study naming the parallelism bug and the
%   "superbug"; also cited by vt-prog-misconceptions' problem-solving
%   analysis.
% QUOTE (pp. 27--28, scan p.3): "the parallelism bug [...] its essence is
%   the assumption that different lines in a program can be active or
%   somehow known by the computer at the same time, or in parallel"; and
%   (scan p.4) "all the lines in the program are active or alive at once";
%   the bugs "appear to derive from [...] a 'superbug' [...] the idea that
%   there is a hidden mind somewhere in the programming language" (scan p.8).
% VERIFIED: full text read via scholar pdf quote over
%   https://web.stanford.edu/~roypea/ (open scan; OCR artifacts cleaned to
%   the legible wording).  Journal: J. Educational Computing Research 2(1),
%   25--36.
% DATE: 2026-07-20
@article{pea1986,
  author  = {Pea, Roy D.},
  title   = {Language-Independent Conceptual ``Bugs'' in Novice Programming},
  journal = {Journal of Educational Computing Research},
  volume  = {2},
  number  = {1},
  pages   = {25--36},
  year    = {1986},
  doi     = {10.2190/689T-1R2A-X4W4-29J2}
}

