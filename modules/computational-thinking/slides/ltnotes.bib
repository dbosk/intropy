% === provenance: wirth1971 ===
% CLAIM: Developing a program by successively refining named steps
%   (tasks/instructions) into more detailed instructions, until everything
%   is expressed in the programming language, is Wirth's stepwise
%   refinement method.
% FOUND-VIA: scholar search 'program development by stepwise refinement
%   Wirth' -p dblp -p s2
% PICKED: the primary source (CACM 1971) over the 1983 CACM reprint and
%   the 2002 Software Pioneers reprint returned by the same search.
% QUOTE (p. 221): "In each step, one or several instructions of the given
%   program are decomposed into more detailed instructions."  Also
%   (p. 221): "the program is gradually developed in a sequence of
%   refinement steps" and (p. 226): "Program construction consists of a
%   sequence of refinement steps."
% VERIFIED: full-text PDF read via scholar pdf quote
%   (https://sunner.cn/courses/C/reference/Wirth71.pdf mirror); applies
%   because it defines exactly the refine-until-programming-language
%   method the ltnote attributes to it.
% DATE: 2026-07-20
@article{wirth1971,
  author  = {Niklaus Wirth},
  title   = {Program Development by Stepwise Refinement},
  journal = {Communications of the ACM},
  year    = {1971},
  volume  = {14},
  number  = {4},
  pages   = {221--227},
  doi     = {10.1145/362575.362577}
}

% === provenance: knuth1984 ===
% CLAIM: Presenting a program as named parts interleaved with prose, in an
%   order suited to human understanding, is Knuth's literate programming.
% FOUND-VIA: scholar search 'Knuth literate programming' -p dblp
% PICKED: the primary journal source (Comput. J. 1984) over the 1992 CSLI
%   book collecting it.
% QUOTE (p. 97): "Let us change our traditional attitude to the
%   construction of programs: Instead of imagining that our main task is
%   to instruct a computer what to do, let us concentrate rather on
%   explaining to human beings what we want a computer to do."  Also
%   (p. 107): "the programmer's task is to state those parts and those
%   relationships, in whatever order is best for human comprehension".
% VERIFIED: full-text PDF read via scholar pdf quote
%   (http://www.literateprogramming.com/knuthweb.pdf); applies because it
%   defines the program-in-named-parts-for-humans idea the ltnote invokes.
% DATE: 2026-07-20
@article{knuth1984,
  author  = {Donald E. Knuth},
  title   = {Literate Programming},
  journal = {The Computer Journal},
  year    = {1984},
  volume  = {27},
  number  = {2},
  pages   = {97--111},
  doi     = {10.1093/comjnl/27.2.97}
}

