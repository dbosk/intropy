% === provenance: GuoMarkelZhang2020 ===
% CLAIM: Learners hold a compound-boolean-condition misconception, writing a
%   chained condition like `if x != a or b` (read in English as "if x is not equal
%   to a or b") instead of comparing each operand; and they assume numeric input
%   read from files/terminal is already numeric when it is still a string.
% FOUND-VIA: original manual review (co-author C. Soori, Google Scholar); full text
%   re-located via DOI 10.1145/3386527.3406733 and read (P. Guo's hosted copy,
%   pg.ucsd.edu)
% FOUND-VIA (here): reused from vt-prog-misconceptions, types.tex and
%   conditionals.tex, literature protocol app:litprotocol.
% PICKED: most specific, verbatim-named learner errors in Guo et al.'s 16,791-
%   explanation learnersourced corpus; the same catalogue backs the co-cited uses
%   in types.tex, repetitions.tex:82, and functions-variables.tex:672.
% QUOTE (Findings, Linguistic Misconceptions): "Incorrectly chaining conditions,
%   like 'if x != a or b' which reads naturally in English as 'if x is not equal to
%   a or b.'"
% QUOTE (Findings, Mathematical Misconceptions): "When numerical data is read from
%   files or terminal input, they often start as strings. If they are not properly
%   converted to numbers, it is still possible to use math operators like + and >
%   on them, which will perform string concatenation and comparison."
% VERIFIED: full-text (re-confirmed verbatim against Guo's copy); the corpus lists
%   each cited misconception as a learner-explanation pattern. NB types.tex:59 says
%   input is "automatically converted to integers" -- Guo's point is it stays a
%   string unless converted; the misconception is the students' assumption it is
%   already numeric (prose nuance flagged for follow-up).
% VERIFIED (here): re-verification pending, see the report accompanying this
%   branch; the quote this deck relies on is the second one (numeric input
%   starts as a string), and the deck states it as the students' assumption,
%   not as an automatic conversion.
% DATE: 2026-09-03
@inproceedings{GuoMarkelZhang2020,
  author = {Guo, Philip J. and Markel, Julia M. and Zhang, Xiong},
  title = {Learnersourcing at Scale to Overcome Expert Blind Spots for
           Introductory Programming: A Three-Year Deployment Study on the
           Python Tutor Website},
  year = {2020},
  isbn = {9781450379519},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3386527.3406733},
  doi = {10.1145/3386527.3406733},
  booktitle = {Proceedings of the Seventh ACM Conference on Learning @ Scale},
  pages = {301--304},
  numpages = {4},
  series = {L@S '20}
}

% === provenance: Bosse2021Antipatterns ===
% CLAIM: A catalogue of CS1 antipatterns derived from student code documents
%   concrete, recurring programming misconceptions in Python (and C) --- among
%   them missing type conversion, using repetition where a selection is needed,
%   a control variable that is never changed (infinite loop), "=" where "==" is
%   meant, omitting "else" for mutually exclusive cases, and defining a function
%   but never calling it.
% FOUND-VIA: scholar systematic review, provider arxiv (session
%   "misconceptions-systematic"); research-question search "What misconceptions
%   do novice students have in introductory programming?"; kept by LLM screening
%   (confidence 0.99). Full query set in literature-protocol.tex.
% FOUND-VIA (here): reused from vt-prog-misconceptions, types.tex,
%   conditionals.tex and repetitions.tex, literature protocol app:litprotocol.
% PICKED: a primary technical report cataloguing 41 antipatterns from 95
%   misconceptions in real CS1 submissions (N=166); its Python and both-language
%   catalogues supply several construct-level misconceptions cited across the
%   types, conditionals, repetitions, and functions chapters.
% QUOTE (P_V5): "Failure to convert, when necessary, will make the data not be
%   in the proper format so that the program can work."
% QUOTE (SS2): "The structure can give the expected result, but since only one
%   of the selections can be true, the second would only need to be checked if
%   the first were false."
% QUOTE (RE1): "using only an equals sign '=' is attribution and not a
%   comparison" ("attribution" is the source's rendering of Portuguese
%   "atribuicao", i.e. assignment; glossed in the prose).
% QUOTE (RS2): "The program will go into an infinite loop because, since the
%   control variable is never changed, the result of the condition that controls
%   the repetition will not change either."
% QUOTE (P_SRS1): "Using repetition where only selection would be required will
%   cause wrong results."
% VERIFIED: full-text (arXiv 2104.12542 read); each cited antipattern's PROBLEM
%   statement entails the misconception it backs in the catalogue chapters. All
%   six quoted PROBLEM passages re-confirmed verbatim against the arXiv PDF
%   text (pdftotext) 2026-07-02.
% VERIFIED (here): re-verification pending, see the report accompanying this
%   branch.  This deck relies on P_V5 only; the other four are used in the
%   companion deck on conditions and control structures.
% DATE: 2026-09-03
@techreport{Bosse2021Antipatterns,
  author      = {Bosse, Yorah and Wiese, Igor Scaliante and
                 Silva, Marco Aur{\'e}lio Graciotto and Lago, Nelson and
                 Brand{\~a}o, Le{\^o}nidas de Oliveira and Redmiles, David and
                 Kon, Fabio and Gerosa, Marco A.},
  title       = {Catalogs of {C} and {Python} Antipatterns by {CS1} Students},
  year        = {2021},
  institution = {arXiv},
  number      = {arXiv:2104.12542},
  type        = {Technical report},
  doi         = {10.48550/arXiv.2104.12542},
  url         = {https://arxiv.org/abs/2104.12542},
}

