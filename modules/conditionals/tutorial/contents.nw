def fjarde_fragan():
    """Ställer den fjärde frågan och ger True om bomben detonerade."""
    svar = input("9 < 10 or 1 < 2 and 2 < 1, sant eller falskt? ")
    if svar == "falskt":
        return detonera()

    return False
@
