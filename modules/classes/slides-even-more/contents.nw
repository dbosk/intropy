<<utför transaktioner>>
@
  \end{example}
\end{frame}

\begin{frame}[fragile]
  \begin{example}[Transaktioner]
    \label{ex:bank-transactions}
    En insättning och ett uttag, med kontroll av uttaget:
<<utför transaktioner>>=
# Utför transaktioner
account.deposit(500)
print(f"Efter insättning: {account.balance} kr")

