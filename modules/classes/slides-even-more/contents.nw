\begin{frame}[fragile]
  \begin{example}[Fler metoder för \texttt{ShoppingList}]
    \label{ex:shopping-check}
    Bocka av och ta bort:
<<metoderna i [[ShoppingList]]>>=
def check_item(self, index):
    if 0 <= index < len(self.items):
        self.items[index]["checked"] = True

def remove_checked(self):
    self.items = [item for item in self.items if not item["checked"]]
@
  \end{example}
\end{frame}

