@
  \end{example}
\end{frame}

\begin{frame}[fragile]
  \begin{example}[Klassen \texttt{Item}]
    \label{ex:item}
    En separat klass för varor, med privata attribut:
<<klassen [[Item]]>>=
class Item:
    """En vara på inköpslistan"""

    def __init__(self, name, checked=False):
        self.__name = name
        self.__checked = checked

    <<egenskaper för namn och avbockning>>

    <<bocka av och bocka ur>>

    <<strängrepresentation av en vara>>
@
  \end{example}
\end{frame}

\begin{frame}[fragile]
  \begin{example}[Egenskaper och metoder i \texttt{Item}]
    \label{ex:item-methods}
    Attributen läses som egenskaper:
<<egenskaper för namn och avbockning>>=
@property
def name(self):
    return self.__name

@property
def checked(self):
    return self.__checked
@
  \end{example}
\end{frame}

\begin{frame}[fragile]
  \begin{example}[Avbockning och utskrift av en vara]
    \label{ex:item-str}
    Avbockningen ändras bara genom metoder:
<<bocka av och bocka ur>>=
def check(self):
    """Bocka av varan"""
    self.__checked = True

def uncheck(self):
    """Ta bort bockning"""
    self.__checked = False
@
    Varan vet själv hur den ska skrivas ut:
<<strängrepresentation av en vara>>=
def __str__(self):
    status = "[X]" if self.__checked else "[ ]"
    return f"{status} {self.__name}"
@
  \end{example}
\end{frame}

Nu har vi inkapsling av varans information i en egen klass.  Varje
\mintinline{python}{Item} har privata attribut och publika egenskaper för
att läsa dem.  Metoden \mintinline{python}{__str__()} gör det enkelt
att skriva ut varan.  Konstruktorn för \mintinline{python}{ShoppingList}
är densamma som förut --- det är samma namngivna steg som i
\cref{ex:shopping-add} --- men metoderna arbetar nu med
\mintinline{python}{Item}-objekt.

