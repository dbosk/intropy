% The \needspace keeps items1.py on one page in the notes.
\mode<article>{\needspace{18\baselineskip}}
\begin{frame}[fragile]
  \begin{exercise}[Vad skriver programmet ut?]
    \label{ovn:stavfel}
    \leavevmode\ltnote{%
      Relevanta lärandemål för \cref{ovn:stavfel}: \cref{AppLORepresentation}.

      \textbf{Kontrast} mot \cref{ex:shopping-add}, där nyckeln heter
      \mintinline{python}{"name"}.  Vad som varierar: om nyckelnamnet
      stämmer.  Vad som hålls invariant: uppslagslistan och koden runt
