def main():
    """Exempel på användning"""
    items = []
    items.append({"name": "Mjölk", "checked": False})
    items.append({"name": "Bröd", "checked": False})

    print(len(items))
    for item in items:
        print(item["namn"])


if __name__ == "__main__":
    main()
