\begin{frame}[fragile]
  \begin{example}[Bocka av och ta bort varuobjekt]
    \label{ex:shopping-items-check}
    Avbockningen sker genom varans egen metod:
<<bocka av och ta bort varuobjekt>>=
def check_item(self, index):
    """Bocka av en vara"""
    if 0 <= index < len(self.items):
        self.items[index].check()

def remove_checked(self):
    """Ta bort alla avbockade varor"""
    self.items = [item for item in self.items if not item.checked]
@
  \end{example}
\end{frame}

Lägg märke till förändringarna:
\begin{description}
  \item[\texttt{add\_item()}] skapar nu \mintinline{python}{Item}-objekt
    istället för uppslagslistor;
  \item[\texttt{list\_items()}] använder
    \mintinline{python}{Item.__str__()} automatiskt för att visa varje
    vara;
  \item[\texttt{check\_item()}] anropar \mintinline{python}{item.check()}
    istället för att ändra uppslagslistan direkt;
  \item[\texttt{remove\_checked()}] använder
    \mintinline{python}{item.checked} (egenskap) istället för
    \mintinline{python}{item["checked"]}.
\end{description}

