from fraction import Fraction

def main():
    """Huvudprogrammet"""
    print(Fraction(1, -2), Fraction(-1, 2), Fraction(-1, -2))
    print(Fraction(6, -12))
    print(Fraction(1, -2) + Fraction(1, 3))
    print(Fraction(-1, 2) + Fraction(1, 3))

