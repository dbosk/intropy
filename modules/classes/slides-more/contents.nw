  \begin{example}[Prova multiplikation]
    \label{ex:fraction-mul-test}
    Vi multiplicerar \(\frac{1}{2}\) och \(\frac{1}{3}\):
<<prova multiplikationen>>=
print(frac_a * frac_b)
<<tester för [[Fraction]]>>=
<<prova multiplikationen>>
@
    Testfallet skriver ut
    \runpython[chdir, deps={examples/fraction.py}]%
      {examples/fraction_test_multiplikation.py}
  \end{example}
\end{frame}

Implementationen använder dundermetoden \mintinline{python}{__mul__()}.
Notera att den även kan hantera multiplikation med heltal genom att
skapa ett \mintinline{python}{Fraction}-objekt av heltalet först.

\begin{frame}
  \begin{exercise}
    \label{ovn:mul-int}
    Vad händer om vi multiplicerar \(\frac{1}{2} \cdot 2\)?  Vilket
    resultat får vi, och i vilken form?
  \end{exercise}
\end{frame}

\begin{frame}[fragile]
  \begin{example}[Multiplicera med ett heltal]
    \label{ex:fraction-mul-int}
    Testfallet multiplicerar \(\frac{1}{2}\) med \(2\):
<<prova multiplikationen med ett heltal>>=
print(frac_a * 2)
<<tester för [[Fraction]]>>=
<<prova multiplikationen med ett heltal>>
@
    Det skriver ut
    \runpython[chdir, deps={examples/fraction.py}]%
      {examples/fraction_test_heltalsmultiplikation.py}
