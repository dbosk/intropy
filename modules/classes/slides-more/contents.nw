    \label{ex:fraction-int}
    Heltalsdelen av beloppen, med bråkets tecken:
<<bråkklassens metoder>>=
def __int__(self):
    quotient = abs(self.numerator) // abs(self.denominator)
    if self.numerator * self.denominator < 0:
        return -quotient
    return quotient
