<<testprogram: jämför med och utan dundermetoder>>=
def main():
    """Test program"""
    my_copy = PlainBook("Madicken", "Astrid Lindgren", 174)
    your_copy = PlainBook("Madicken", "Astrid Lindgren", 174)
    my_copy.read(50)
    print(my_copy == your_copy)

    my_copy = Book("Madicken", "Astrid Lindgren", 174)
    your_copy = Book("Madicken", "Astrid Lindgren", 174)
    my_copy.read(50)
    print(my_copy == your_copy)

    print(PlainBook.__bases__)
    print(object.__str__)
    print(object.__eq__)
    print(PlainBook.__str__ is object.__str__)
    print(Book.__str__ is object.__str__)

if __name__ == "__main__":
    main()
@
  \end{example}
\end{frame}

