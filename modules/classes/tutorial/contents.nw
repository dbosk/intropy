    varken \mintinline{python}{__str__}, \mintinline{python}{__lt__}
    eller \mintinline{python}{__eq__}.
<<[[plain.py]]>>=
"""The book without its dunder methods, beside the one with them"""

from book import Book


class PlainBook:
    """A book that has been given no dunder method but the constructor"""

    <<konstruktorn för [[Book]]>>

    <<metoden som flyttar bokmärket>>

    <<läsmetoder för [[Book]]>>
@
    Vad skriver \mintinline{python}{print} på ett sådant objekt ut, och
    vad svarar \mintinline{python}{==} på två av dem med samma
    uppgifter?  Ställ sedan samma två frågor till en riktig
    \mintinline{python}{Book} med samma uppgifter.  Förutsäg först och
    kör sedan --- och ta reda på var svaren kommer ifrån.  Klassen kan
    svara på det själv.
  \end{exercise}
\end{frame}

\begin{frame}
  \begin{exercise}[En bok med en utlånare]
    \label{ovn:arv}
    Skriv en klass för en lånad bok.  Den ska kunna allt en
    \mintinline{python}{Book} kan, och dessutom hålla reda på vem du har
    lånat den av.  Utskriften ska säga det, på en rad:
    \begin{center}\scriptsize
      \begin{tabular}{@{}l@{}}
        \texttt{Mio min Mio av Astrid Lindgren (60/200 sidor lästa),
          lånad av Birk}
      \end{tabular}
    \end{center}
    Du får inte upprepa någon av \mintinline{python}{Book}s rader.
