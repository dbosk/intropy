"""The book without its dunder methods, beside the one with them"""

from book import Book

class PlainBook:
    """A book that has been given no dunder method but the constructor"""

    def __init__(self, title, author, pages):
        """title: string with the title of the book.
        author: string with the name of the author.
        pages: integer, the number of pages in the book"""
        self.__title = title
        self.__author = author
        self.__pages = pages
        self.__read_pages = 0

    def read(self, pages):
        """Moves the bookmark forward `pages` pages.
        Raises ValueError if that would pass the last page."""
        new_position = self.__read_pages + pages
        if pages < 0 or new_position > self.__pages:
            raise ValueError(
                f"kan inte läsa {pages} sidor från sidan "
                f"{self.__read_pages} i en bok på "
                f"{self.__pages} sidor"
            )
        self.__read_pages = new_position

    def get_title(self):
        """Returns the title"""
        return self.__title

    def get_author(self):
        """Returns the name of the author"""
        return self.__author

    def get_pages(self):
        """Returns the number of pages in the book"""
        return self.__pages

    def get_read_pages(self):
        """Returns the number of pages read so far"""
        return self.__read_pages
@
