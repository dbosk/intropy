from book import Book


def main():
    """Test program"""
    ronja = Book("Ronja Rövardotter", "Astrid Lindgren", 240)
    madicken = Book("Madicken", "Astrid Lindgren", 180)
    ronja.read(50)
    try:
        madicken.read(300)
    except ValueError as error:
        print(f"Hoppsan: {error}")
    print(ronja)
    print(madicken)


if __name__ == "__main__":
    main()
@
