    person = Person("Anne-Marie", "Ingeström", "1907-08-28", "Vimmerby", "-")
    person2 = Person("Ada", "Bedasdotter", "1990-01-01", "Kiruna", "-")

    person.change_name("Margareta Engström")
    print(person)
    print(person2)

if __name__ == "__main__":
    main()
@
  \end{exercise}
\end{frame}

