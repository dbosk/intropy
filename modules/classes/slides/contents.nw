  Relevanta lärandemål: \cref{ClassLODunder}.

  \Cref{ovn:total-ordering} visar dekoratorn i stället för att bara
  nämna den.  \textbf{Kontrast} mot \cref{ovn:eq}: samma två Ada, men
  nu med \mintinline{python}{__eq__}, så att likheten gäller värdena.
  En egen klass, så att \mintinline{python}{Person} och
  \texttt{compare.py} är oförändrade.
}%
    Klassen har \mintinline{python}{__eq__} och
    \mintinline{python}{__lt__}, och dekoratorn:
<<[[comparable.py]]>>=
"""Personer som kan jämföras med alla sex jämförelseoperatorerna"""

import functools

@functools.total_ordering
class ComparablePerson:
    """En person med namn och födelsedag"""

    def __init__(self, name, birthday):
        self.__name = name
        self.__birthday = birthday

    def __eq__(self, other):
        """Returnerar True om self och other har samma namn och
        födelsedag"""
        return (
            self.__name == other.__name and self.__birthday == other.__birthday
        )

    def __lt__(self, other):
        """Returnerar True om self är yngre än other; vid samma
        födelsedag avgör namnet"""
        if self.__birthday == other.__birthday:
            return self.__name < other.__name
        return self.__birthday > other.__birthday

def main():
    """Huvudprogram"""
    ada = ComparablePerson("Ada Bedasdotter", "1990-01-01")
    ada2 = ComparablePerson("Ada Bedasdotter", "1990-01-01")
    madicken = ComparablePerson("Madicken Engström", "1907-08-28")

    print(ada == ada2)
    print(ada <= ada2)
    print(ada >= madicken)
    print(madicken >= ada)

if __name__ == "__main__":
    main()
@
  \end{exercise}
\end{frame}

