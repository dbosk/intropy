import textwrap

sys.path.insert(0, "examples")


def phonebook_source(module):
    """Returns the lines of module's main that store the contacts"""
    lines = inspect.getsource(module.main).splitlines()
    start = next(i for i, line in enumerate(lines) if "phonebook =" in line)
    end = lines.index("    }", start)
    return textwrap.dedent("\n".join(lines[start : end + 1]))


def side_by_side(left, right, width, modes):
    """Prints left and right side by side, the left column width (a
    fraction of the full width) wide, in each of modes"""
    for mode in modes:
        if mode == "article":
            start, end, options = r"\begin{fullwidth}", r"\end{fullwidth}", ""
        else:
            start, end, options = "", "", r"fontsize=\tiny"
        print(r"\mode<%s>{%s" % (mode, start))
        print(
            r"\begin{tabular}{@{}p{%.2f\columnwidth}@{\hspace{1em}}"
            r"p{%.2f\columnwidth}@{}}" % (width, 0.97 - width)
        )
        didactic_mint(left, lang="python", minted_opts=options)
        print("&")
        didactic_mint(right, lang="python", minted_opts=options)
        print(r"\end{tabular}%s}" % end)


contacts = didactic_import("contacts", "examples/contacts.py")
contacts_class = didactic_import(
    "contacts_class", "examples/contacts_class.py"
)
side_by_side(
    phonebook_source(contacts),
    phonebook_source(contacts_class),
    0.33,
    ["article", "presentation"],
)
\end{pycode}
    \caption{De två sätten att lagra kontakterna: de nästlade
      uppslagslistorna ur \texttt{contacts.py} till vänster och
