def __lt__(self, other):
    """Returnerar True om self är yngre än other,
    annars False"""
    # ett tidigare födelsedatum betyder äldre
    return self.get_birthday() > other.get_birthday()

def __repr__(self):
    """Returnerar en entydig representation"""
    return (
        f"({self}, {self.get_birthday()}, {self.get_address()}, "
        f"{self.get_phone()})"
    )
@
