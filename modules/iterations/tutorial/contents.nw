<<frågelistans huvudprogram med en for-slinga>>=
def main():
    """Går igenom frågorna med en for-slinga."""
    for fråga, svar in FRÅGOR:
        ställ_fråga(fråga, svar)

if __name__ == "__main__":
    main()
@
