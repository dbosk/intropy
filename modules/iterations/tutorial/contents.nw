def ge_försök(fråga, svar, antal):
    """Ger antal försök; sant om svaret blev rätt."""
    for försök in range(antal):
        if fråga_tal(fråga + " ") == svar:
            return True

        if försök < antal - 1:
            print("Fel, försök igen.")

    print(f"Slut på försök, svaret är {svar}.")
    return False

<<funktion som frågar tills svaret är ett heltal>>
