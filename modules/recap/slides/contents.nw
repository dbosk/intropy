    old = balance
    balance = balance + 500
    print(f"Förut {old} kr, nu {balance} kr")


if __name__ == "__main__":
    main()
@
    \begin{pycode}
print(fraga(
    mc,
    "Vad skriver saldo.py ut?",
    [
        "Förut 1000 kr, nu 1500 kr",
        "Förut 1500 kr, nu 1500 kr",
        "Förut 1000 kr, nu 1000 kr",
        "Förut {old} kr, nu {balance} kr",
