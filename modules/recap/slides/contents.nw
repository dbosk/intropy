    \label{ex:recap-sparkonto}
    Klassen, i [[bank.py]], och körningen:
<<bankens övriga klasser>>=
class SavingsAccount(Account):
    """Ett sparkonto: ett konto som också ger ränta"""

    def __init__(self, number, owner, balance=0, rate=0.02):
        super().__init__(number, owner, balance)
        self.__rate = rate

    def add_interest(self):
        """Sätter in räntan på saldot"""
        self.deposit(self.balance * self.__rate)
@
    \runpython[showcommand, chdir]{examples/sparkonto.py}
