% Varje övning nedan är en fråga i Mentipy: på bilderna en enkät med en
% QR-kod, i anteckningarna en vanlig övningsuppgift.  Det som alla frågor
% har gemensamt ställs in en gång, här, i båda jobben.
\mode<all>
\begin{pycode}
import re

from mentipy.latex import mc, open_text, scale
from mentipy.store import Store

mentipy_common = {
    "store": Store("mentipy.json"),
    "qr_dir": "mentipy-obj",
    "qr_format": "png",
    "environment": "",
    "show_url": False,
    "layout": "auto",
    "base_url": "http://faculty-shell.sys.kth.se:8080",
}


def _pa_svenska(latex):
    """Byt Mentipys fasta engelska fraser mot svenska."""
    latex = latex.replace("Choose exactly one:", "Välj ett alternativ:")
    latex = latex.replace(
        "Choose one or more:", "Välj ett eller flera alternativ:"
    )
    latex = latex.replace(
        "\\item[Type] Free-text answer", "\\item[Svar] Fritext"
    )
    latex = re.sub(
        r"\\item\[Limit\] (\d+) characters", r"\\item[Högst] \1 tecken", latex
    )
    latex = latex.replace("\\item[Range]", "\\item[Skala]")
    latex = latex.replace("\\item[Low]", "\\item[Lägst]")
    latex = latex.replace("\\item[High]", "\\item[Högst]")
    return latex


def fraga(helper, *args, **kwargs):
    """Registrera en fråga och lämna tillbaka dess LaTeX, på svenska."""
    latex = helper(*args, **{**mentipy_common, **kwargs})
    return _pa_svenska(latex)
\end{pycode}

