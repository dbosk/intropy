\begin{frame}[fragile,shrink]
  \begin{exercise}
    \label{ovn:recap-fil}
    [[fil1.py]] sparar två gånger i samma fil:
<<funktion som sparar kontona i en fil>>=
def save(accounts, filename):
    """Sparar kontona i filen filename, ett konto per rad"""
    with open(filename, "w") as file:
        for number, balance in accounts.items():
            file.write(f"{number},{balance}\n")
<<filprogrammets huvudprogram>>=
def main():
    save({"1001": 1500, "1002": 300}, "konton.txt")
    save({"1003": 2000}, "konton.txt")
    print(load("konton.txt"))


if __name__ == "__main__":
    main()
@
