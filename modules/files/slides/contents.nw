  \mode<presentation>{\setminted{fontsize=\tiny}}%
  \begin{example}[\texttt{close1.py} och \texttt{close2.py}]
    \label{ex:close-bredvid}
    Programmen körda på samma fil, [[close1.py]] till vänster:
    \codebycode
      [name=main, nodocstring,
        label={\texttt{close1.py}}]{python}{examples/close1.py}
      [name=main, nodocstring,
        label={\texttt{close2.py}}]{python}{examples/close2.py}
    \runbyrun
      [transcript]{examples/close1.py}
