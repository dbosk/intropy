% The two ways of reading side by side (\codebycode reads the tangled
% files, so the pair cannot drift from the chunks).  The module
% docstrings and the __name__ guard are the same in both and are cut;
% breaklines wraps only on the slides, where the docstrings are wider
% than a column.
\begin{frame}
  \begin{example}[Hela filen eller rad för rad]
    \label{ex:lasmetoder-bredvid}
    Till vänster [[read_all.py]]: allt hamnar i en enda sträng i
    primärminnet.  Till höger [[read_lines.py]]: bara en rad i taget
    behöver finnas där.
    \codebycode
      [name=main, breaklines,
        label={\texttt{read\_all.py}}]{python}{examples/read_all.py}
      [name=main, breaklines,
        label={\texttt{read\_lines.py}}]{python}{examples/read_lines.py}
  \end{example}
\end{frame}

\begin{frame}
  \begin{remark}[Val av läsmetod]
    \leavevmode\ltnote{%
      \textbf{Explicit svar på övningsfrågan} i \cref{ovn:lasmetod}:
