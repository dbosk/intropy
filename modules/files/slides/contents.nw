\begin{frame}<article>[fragile]
  \begin{example}[Söka i en fil]
    Sökningen ger antalet för namnet, eller noll:
<<namnsökningens hjälpfunktioner>>=
def count_of(name, filename):
    """Returns how many carry the name according to the file, or 0"""
    with open(filename, "r", newline="") as file:
        for row_name, count in csv.reader(file, delimiter=";"):
            if row_name.strip() == name:
                return int(count.replace(",", ""))
    return 0
@
  \end{example}
\end{frame}

