\begin{frame}[fragile]
  \begin{exercise}[Vad skriver \texttt{close1.py} ut?]
    \label{ovn:sarfall}
    \only<article>{Programmet läser [[text.txt]] och frågar till sist om
    filen är stängd:}
<<[[close1.py]]>>=
"""Reading a number from a file, closing the file by hand"""

def main():
    """Reads the number, closing the file by hand"""
    file = open("text.txt", "r")
    try:
        print("Talet är", int(file.read()))
        file.close()
    except ValueError:
        print("Det stod inget tal i filen")
    print("Filen är stängd:", file.closed)

if __name__ == "__main__":
    main()
@
  \end{exercise}
\end{frame}

