    try:
        contacts = load_contacts(FILENAME)
    except FileNotFoundError:
        contacts = {}
    name = input("Namn: ")
    contacts[name] = input("Telefonnummer: ")
    save_contacts(contacts, FILENAME)
    with open(FILENAME, "r") as file:
        print("Filen innehåller:")
        print(file.read(), end="")

if __name__ == "__main__":
    main()
@
  \end{example}
\end{frame}

Läsningen och skrivningen är de från talparsprogrammet med modulen
[[csv]], men med uppslagslistans nycklar och värden i stället för talpar.

\begin{frame}<article>[fragile]
  \begin{example}[Läsa och spara telefonboken]
    Varje rad i filen är ett namn och ett nummer:
<<CSV-telefonbokens hjälpfunktioner>>=
def load_contacts(filename):
    """Reads the phone book (a dictionary) from the file"""
    contacts = {}
    with open(filename, "r", newline="") as file:
        for name, number in csv.reader(file):
            contacts[name] = number
    return contacts

def save_contacts(contacts, filename):
    """Saves the phone book to the file as CSV"""
    with open(filename, "w", newline="") as file:
        writer = csv.writer(file)
        for name, number in contacts.items():
            writer.writerow([name, number])
@
  \end{example}
\end{frame}

