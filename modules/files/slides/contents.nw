"""Reading the number in the file"""

def compare_and_double(value):
    """Prints whether value is 42, then value times two"""
    print(value == 42)
    print(value * 2)

def main():
    """Uses the content as it comes, then converted"""
    with open("tal.txt", "r") as file:
        content = file.read().strip()
    compare_and_double(content)
    compare_and_double(int(content))

